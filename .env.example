SECRET_KEY=change-this-to-a-long-random-string

# MySQL (local MySQL or AWS RDS endpoint)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=student_management

# S3 (private bucket). On EC2 with an IAM role, leave the two keys blank.
S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Let students create their own account from the login page (true/false)
ALLOW_SELF_REGISTRATION=true

# Email confirmation (Amazon SNS). Students must click the link AWS emails them before they can log in.
REQUIRE_EMAIL_CONFIRMATION=true
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:student-email-confirmation

# true = documents are served through the app (needed when S3 is reachable only from the VPC)
PROXY_DOCUMENTS=true
